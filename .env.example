# Copy to .env.local for local development. Never commit real values.

# Optional. Enables the live LLM Copilot and AI executive summary. Without it the app shows a clearly
# labelled "Rule-based fallback (not AI)" and everything else keeps working.
ANTHROPIC_API_KEY=

# Optional. Claude model ID (default: claude-sonnet-5-5).
ANTHROPIC_MODEL=

# Public base URL used for metadata / Open Graph (e.g. https://bevcast-ai.vercel.app).
NEXT_PUBLIC_APP_URL=

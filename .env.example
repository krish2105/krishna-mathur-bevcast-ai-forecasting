# Copy to .env.local for local development. Never commit real values.

# Optional. Google Gemini API key (Google AI Studio). Enables the live LLM Copilot and AI executive summary.
# Without it the app shows a clearly labelled "Rule-based fallback (not AI)" and everything else keeps working.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Gemini model ID (default: gemini-3.5-flash-lite) and comma-separated backups
# (default: gemini-3.1-flash-lite,gemini-3.6-flash; "none" disables them).
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# Public base URL used for metadata / Open Graph (e.g. https://bevcast-ai.vercel.app).
NEXT_PUBLIC_APP_URL=
